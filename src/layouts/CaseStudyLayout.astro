---
import BaseLayout from './BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import FinalCTA from '../components/sections/FinalCTA.astro';
import { projects } from '../data/projects.js';

export interface Props {
  slug: string;
  title: string;
  description: string;
  /** Schema.org type for the structured data block */
  schemaType?: string;
  /**
   * Optional Google Fonts href. Case studies whose mockup uses the client's own
   * typeface load it here so the brand reads as genuinely distinct from Mayfly's.
   */
  fontHref?: string;
}

const { slug, title, description, schemaType = 'CreativeWork', fontHref } = Astro.props;

const idx     = projects.findIndex((p) => p.slug === slug);
const project = projects[idx];
const next    = projects[(idx + 1) % projects.length];

const isConcept = project.status === 'concept';
---

<BaseLayout title={title} description={description}>
  {fontHref && (
    <Fragment slot="head">
      <link rel="preload" as="style" href={fontHref} onload="this.onload=null;this.rel='stylesheet'" />
      <noscript><link rel="stylesheet" href={fontHref} /></noscript>
    </Fragment>
  )}

  <script type="application/ld+json" slot="head" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': schemaType,
    name: project.name,
    description: description,
    url: `https://mayflywebdesign.com/work/${project.slug}/`,
    creator: {
      '@type': 'Organization',
      name: 'Mayfly Web Design',
      url: 'https://mayflywebdesign.com',
    },
    about: project.industry,
  })} />

  <Header />
  <main id="main-content">

    <!-- ── Breadcrumb ─────────────────────────────────────── -->
    <nav class="cs-crumb" aria-label="Breadcrumb">
      <div class="section-container">
        <a href="/work/">Work</a>
        <span aria-hidden="true">/</span>
        <span class="cs-crumb-current">{project.name}</span>
      </div>
    </nav>

    <!-- ── Hero ───────────────────────────────────────────── -->
    <section class="cs-hero">
      <div class="section-container">
        <div class="cs-hero-grid">
          <div class="cs-hero-main">
            <span class:list={['cs-badge', isConcept ? 'cs-badge--concept' : 'cs-badge--shipped']}>
              {project.statusLabel}
            </span>
            <h1 class="cs-title reveal">{project.name}</h1>
            <p class="cs-tagline reveal" style="transition-delay:0.08s">{project.tagline}</p>
          </div>

          <dl class="cs-facts reveal" style="transition-delay:0.16s">
            <div class="cs-fact">
              <dt>Industry</dt>
              <dd>{project.industry}</dd>
            </div>
            <div class="cs-fact">
              <dt>Location</dt>
              <dd>{project.location}</dd>
            </div>
            <div class="cs-fact">
              <dt>Scope</dt>
              <dd>{project.scope.join(', ')}</dd>
            </div>
            {project.liveUrl && (
              <div class="cs-fact">
                <dt>Live at</dt>
                <dd>
                  <a href={project.liveUrl} target="_blank" rel="noopener noreferrer" class="cs-live-link">
                    {project.liveLabel}
                    <svg width="11" height="11" viewBox="0 0 11 11" fill="none" aria-hidden="true">
                      <path d="M2 9L9 2M9 2H3.5M9 2v5.5" stroke="currentColor" stroke-width="1.4"
                            stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </a>
                </dd>
              </div>
            )}
          </dl>
        </div>
      </div>
    </section>

    <!-- ── Concept disclosure ─────────────────────────────── -->
    {isConcept && (
      <div class="section-container">
        <p class="cs-disclosure">
          <strong>This is a concept build.</strong> Larkspur and Ninebark are illustrative
          Montana businesses, not clients — so there are no performance numbers to quote here.
          What you're looking at is the actual strategy and design work: the brief we'd write,
          the decisions we'd make, and the site we'd ship.
        </p>
      </div>
    )}

    <slot />

    <!-- ── Next project ───────────────────────────────────── -->
    <section class="cs-next">
      <div class="section-container">
        <a href={`/work/${next.slug}/`} class="cs-next-link">
          <span class="cs-next-label">Next project</span>
          <span class="cs-next-name">
            {next.name}
            <svg width="22" height="12" viewBox="0 0 22 12" fill="none" aria-hidden="true">
              <path d="M1 6h19M15 1l5 5-5 5" stroke="currentColor" stroke-width="1.4"
                    stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </span>
          <span class="cs-next-industry">{next.industry}</span>
        </a>
      </div>
    </section>

    <FinalCTA />
  </main>
  <Footer />
</BaseLayout>

<style>
  /* ── Breadcrumb ─────────────────────────────────────────── */
  .cs-crumb {
    padding: 1.5rem 0 0;
    font-family: var(--font-body);
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    color: var(--color-muted);
  }
  .cs-crumb a { color: var(--color-accent); text-decoration: none; }
  .cs-crumb a:hover { text-decoration: underline; }
  .cs-crumb span { margin: 0 0.5rem; }
  .cs-crumb-current { color: var(--color-muted); margin-left: 0 !important; }

  /* ── Hero ───────────────────────────────────────────────── */
  .cs-hero { padding: 2.5rem 0 3.5rem; }
  .cs-hero-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
  }
  @media (min-width: 900px) {
    .cs-hero-grid { grid-template-columns: 1.35fr 1fr; gap: 4rem; align-items: end; }
  }

  .cs-badge {
    display: inline-block;
    font-family: var(--font-body);
    font-size: 0.625rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    padding: 0.3rem 0.6rem;
    margin-bottom: 1.25rem;
  }
  .cs-badge--concept {
    color: var(--color-gold);
    border: 1px solid rgba(184, 136, 46, 0.4);
  }
  .cs-badge--shipped {
    color: var(--color-bg);
    background-color: var(--color-accent-solid);
  }

  .cs-title {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: clamp(2.5rem, 6vw, 4.25rem);
    letter-spacing: -0.03em;
    line-height: 1.02;
    color: var(--color-text);
  }
  .cs-tagline {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 300;
    font-size: clamp(1.125rem, 2.2vw, 1.5rem);
    line-height: 1.45;
    color: var(--color-muted);
    margin-top: 1.125rem;
    max-width: 32ch;
  }

  .cs-facts {
    display: grid;
    gap: 1.25rem;
    border-top: 1px solid var(--color-surface);
    padding-top: 1.5rem;
  }
  @media (min-width: 480px) and (max-width: 899px) {
    .cs-facts { grid-template-columns: repeat(2, 1fr); gap: 1.5rem 2rem; }
  }
  .cs-fact dt {
    font-family: var(--font-body);
    font-size: 0.625rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-muted);
    margin-bottom: 0.3rem;
  }
  .cs-fact dd {
    font-family: var(--font-body);
    font-size: 0.9375rem;
    font-weight: 400;
    line-height: 1.5;
    color: var(--color-text);
  }
  .cs-live-link {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    color: var(--color-accent);
    text-decoration: none;
    border-bottom: 1px solid currentColor;
    padding-bottom: 1px;
  }
  .cs-live-link:hover { opacity: 0.7; }

  /* ── Concept disclosure ─────────────────────────────────── */
  .cs-disclosure {
    font-family: var(--font-body);
    font-size: 0.875rem;
    font-weight: 300;
    line-height: 1.65;
    color: var(--color-muted);
    background-color: var(--color-surface);
    border-left: 2px solid var(--color-gold);
    padding: 1.125rem 1.375rem;
    max-width: 68ch;
    margin-bottom: 1rem;
  }
  .cs-disclosure strong { font-weight: 500; color: var(--color-text); }

  /* ── Next project ───────────────────────────────────────── */
  .cs-next {
    border-top: 1px solid var(--color-surface);
    padding: 3.5rem 0;
  }
  .cs-next-link {
    display: block;
    text-decoration: none;
    color: inherit;
  }
  .cs-next-label {
    display: block;
    font-family: var(--font-body);
    font-size: 0.625rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-muted);
    margin-bottom: 0.625rem;
  }
  .cs-next-name {
    display: inline-flex;
    align-items: center;
    gap: 0.875rem;
    font-family: var(--font-display);
    font-weight: 300;
    font-size: clamp(1.75rem, 4vw, 2.75rem);
    letter-spacing: -0.025em;
    color: var(--color-text);
    transition: color 0.2s ease;
  }
  .cs-next-name svg { transition: transform 0.25s ease; flex-shrink: 0; }
  .cs-next-link:hover .cs-next-name { color: var(--color-accent); }
  .cs-next-link:hover .cs-next-name svg { transform: translateX(6px); }
  .cs-next-industry {
    display: block;
    font-family: var(--font-body);
    font-size: 0.875rem;
    font-weight: 300;
    color: var(--color-muted);
    margin-top: 0.375rem;
  }
</style>
