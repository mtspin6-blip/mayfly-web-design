---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import Hero from '../components/sections/Hero.astro';
import ServicesGrid from '../components/sections/ServicesGrid.astro';
import ValueProps from '../components/sections/ValueProps.astro';
import SocialProof from '../components/sections/SocialProof.astro';
import PricingSnapshot from '../components/sections/PricingSnapshot.astro';
import FinalCTA from '../components/sections/FinalCTA.astro';
import RelatedGuides from '../components/sections/RelatedGuides.astro';
---

<BaseLayout
  title="Montana Web Design | Mayfly Web Design, Missoula MT"
  description="Web design in Montana from a Missoula web designer. $0 upfront websites from $59/month, plus business automation and local SEO for small businesses."
>
  <Header />
  <main id="main-content">
    <Hero />
    <ServicesGrid />
    <ValueProps />
    <SocialProof />
    <PricingSnapshot />
    <RelatedGuides heading="Guides for Montana small business owners" limit={5} cities />
    <FinalCTA />
  </main>
  <Footer />
</BaseLayout>
