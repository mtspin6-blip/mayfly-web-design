---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import PricingSnapshot from '../components/sections/PricingSnapshot.astro';
import FinalCTA from '../components/sections/FinalCTA.astro';

const localVisibility = [
  {
    name:     'GBP Setup',
    price:    '$199',
    monthly:  'one-time',
    desc:     'Get your Google Business Profile claimed, optimized, and connected to your new site.',
    features: [
      'Profile setup or claiming assistance',
      'Categories, description, hours, services',
      'Photos and website connection',
      'Basic optimization',
    ],
    cta:      { href: '/contact/', label: 'Get Started' },
    featured: false,
  },
  {
    name:     'Local SEO',
    price:    '$299',
    monthly:  '/mo',
    desc:     'For Montana businesses ready to show up locally in Google and Maps.',
    features: [
      'Local keyword research',
      'On-page SEO + service/location pages',
      'Google Business Profile optimization',
      'Search Console &amp; Analytics monitoring',
      'Monthly reporting',
      '4 SEO-focused blog posts/month',
    ],
    cta:      { href: '/contact/', label: 'Get Started' },
    featured: true,
  },
];

const addOns = [
  { item: 'Additional section',            price: '$49' },
  { item: 'Additional page',               price: '$149' },
  { item: 'Extensive build-out / redesign', price: 'Custom quote' },
  { item: 'Booking / scheduling',          price: '$99 setup + $29/mo' },
  { item: 'Lead / contact form',           price: '$49 setup + $9/mo' },
  { item: 'Payment / checkout',            price: '$299 setup + $39/mo' },
  { item: 'AI &amp; automation',           price: 'Custom' },
];

const websiteFaqs = [
  { q: 'Why is it $0 upfront?', a: 'Instead of a big design bill, you pay a low monthly rate that covers the build, hosting, and ongoing maintenance. There\'s a 6-month minimum so we can recover the build cost — after that you\'re month-to-month.' },
  { q: 'What happens after the 6-month minimum?', a: 'The plan automatically continues month-to-month. You can cancel anytime after that with 30 days\' notice.' },
  { q: 'What if I cancel early?', a: 'Since the site is built for $0 upfront, you\'re responsible for the remaining months in the 6-month minimum. Example: cancel after month 3 on Starter and 3 months remain — $177.' },
  { q: 'Do I own my website?', a: 'Mayfly owns and maintains the site while your subscription is active. You can buy it outright anytime — $750 for Starter, $1,500 for Business — and it\'s fully yours. Your domain is always your own asset, subscription or not.' },
  { q: 'What counts as a "minor update"?', a: 'Small text edits, swapping a photo, updating hours or contact info — included every month. New pages, sections, redesigns, or added functionality are billable add-ons, quoted before we start.' },
  { q: 'Can I move to the annual plan later?', a: 'Yes, anytime. Annual is $599/year for Starter or $999/year for Business — a discount over paying monthly, with less billing hassle.' },
];

const addOnFaqs = [
  { q: 'How do add-ons work?', a: 'Add-ons like booking, lead forms, or payments are quoted with a small one-time setup fee plus a recurring monthly charge for the tool itself. Recurring add-ons run only while your website subscription is active.' },
  { q: 'What does AI/automation cost?', a: 'It depends on your workflow — lead follow-up, review requests, and CRM integrations are all quoted individually. Book a call and we\'ll scope it together.' },
];
---

<BaseLayout
  title="Pricing | Mayfly Web Design — Montana"
  description="$0 upfront web design for Montana businesses. Starter $59/mo, Business $99/mo — no big upfront bill, cancel or buy out anytime."
>
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      ...websiteFaqs.map(f => ({ "@type": "Question", "name": f.q, "acceptedAnswer": { "@type": "Answer", "text": f.a } })),
      ...addOnFaqs.map(f => ({ "@type": "Question", "name": f.q, "acceptedAnswer": { "@type": "Answer", "text": f.a } })),
    ]
  })} slot="head"></script>

  <Header />
  <main id="main-content">
    <section class="page-hero">
      <div class="page-hero-photo" aria-hidden="true"></div>
      <div class="page-hero-dim"   aria-hidden="true"></div>
      <div class="section-container" style="position:relative;z-index:2">
        <p class="section-eyebrow reveal">Pricing</p>
        <h1 class="page-headline reveal" style="transition-delay:0.08s">
          $0 upfront.<br /><em>Simple monthly pricing.</em>
        </h1>
        <p class="page-sub reveal" style="transition-delay:0.16s">
          No $1,500–$5,000 upfront bill. Pick Starter or Business, pay month to month
          (or save with annual), and add exactly what you need as your business grows.
        </p>
      </div>
    </section>

    <div class="pricing-section-label"><span>Website Plans</span></div>
    <PricingSnapshot />

    <!-- ── Annual & Buyout ──────────────────────── -->
    <section class="terms-section">
      <div class="section-container">
        <div class="terms-grid">
          <div class="terms-card reveal">
            <p class="section-eyebrow">Pay Annually</p>
            <h3 class="terms-title">Save with an annual plan</h3>
            <p class="terms-body">
              Starter: <strong>$599/year</strong> (saves $109) &nbsp;·&nbsp;
              Business: <strong>$999/year</strong> (saves $189).
              One payment, no monthly billing to think about.
            </p>
          </div>
          <div class="terms-card reveal" style="transition-delay:0.08s">
            <p class="section-eyebrow">Own It Outright</p>
            <h3 class="terms-title">Buy out your website anytime</h3>
            <p class="terms-body">
              Starter buyout: <strong>$750</strong> &nbsp;·&nbsp;
              Business buyout: <strong>$1,500</strong>.
              Pay once and the site — code, design, everything — is yours to keep, no subscription required.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- ── Local Visibility Pricing ──────────────────────── -->
    <div class="pricing-section-label"><span>Local Visibility</span></div>
    <section class="seo-pricing-section">
      <div class="section-container">
        <div class="reveal">
          <p class="section-eyebrow">Google Business Profile &amp; Local SEO</p>
          <h2 class="seo-headline reveal" style="transition-delay:0.06s">
            Get found locally,<br /><em>once your site is live.</em>
          </h2>
          <p class="seo-sub reveal" style="transition-delay:0.12s">
            Once your site is up, get in front of the customers already searching for you in Google and Maps.
          </p>
        </div>

        <div class="auto-grid auto-grid--two">
          {localVisibility.map((t, i) => (
            <div
              class:list={['auto-card reveal', { 'auto-card--dark': t.featured, 'pricing-card--glow-once': t.featured }]}
              style={`transition-delay:${i * 0.1}s`}
            >
              {t.featured && <div class="featured-tag">Most Popular</div>}
              <div class="card-top">
                <p class="tier-name">{t.name}</p>
                <p class="tier-price seo-price">{t.price} <span class="seo-monthly">{t.monthly}</span></p>
                <p class="tier-desc">{t.desc}</p>
              </div>
              <ul class="tier-features" role="list">
                {t.features.map(f => (
                  <li class="tier-feature">
                    <svg width="13" height="13" viewBox="0 0 13 13" fill="none" aria-hidden="true">
                      <path d="M2 6.5l3 3 6-6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                    <span set:html={f} />
                  </li>
                ))}
              </ul>
              <a
                href={t.cta.href}
                class:list={[t.featured ? 'btn-primary' : 'btn-secondary', 'tier-cta']}
              >
                {t.cta.label}
                <span class="btn-arrow" aria-hidden="true">→</span>
              </a>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Add-ons -->
    <div class="pricing-section-label"><span>Add-Ons</span></div>
    <section class="addons-section">
      <div class="section-container">
        <div class="reveal">
          <p class="section-eyebrow">Add-Ons</p>
          <h2 class="section-headline" style="margin-bottom:2.5rem">Build exactly what you need, when you need it</h2>
        </div>
        <div class="addons-grid reveal" style="transition-delay:0.1s">
          {addOns.map(a => (
            <div class="addon-row">
              <span class="addon-item" set:html={a.item} />
              <span class="addon-price">{a.price}</span>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="faq-section">
      <div class="section-container">
        <div class="reveal">
          <p class="section-eyebrow">FAQ</p>
          <h2 class="section-headline" style="margin-bottom:3rem">Common questions</h2>
        </div>
        <dl class="faq-list">
          {[...websiteFaqs, ...addOnFaqs].map((f, i) => (
            <div class="faq-item reveal" style={`transition-delay:${i * 0.08}s`}>
              <dt class="faq-q">{f.q}</dt>
              <dd class="faq-a">{f.a}</dd>
            </div>
          ))}
        </dl>
      </div>
    </section>

    <FinalCTA />
  </main>
  <Footer />
</BaseLayout>

<style>
  .page-hero {
    /* Dark ground: text tokens swap to their light variants (see global.css). */
    --color-accent: var(--color-accent-light);
    --color-muted: var(--color-muted-light);
    --color-gold: var(--color-gold-light);
    background-color: var(--color-bg);
    padding: 5rem 0 4rem;
    min-height: clamp(240px, 32vh, 440px);
    border-bottom: 1px solid var(--color-surface);
    position: relative;
    overflow: hidden;
  }
  .page-hero-photo {
    position: absolute;
    inset: 0;
    background-image: url('https://images.unsplash.com/photo-1497366216548-37526070297c?w=1920&auto=format&fit=crop&q=80');
    background-size: cover;
    background-position: center 40%;
    z-index: 0;
  }
  .page-hero-dim {
    position: absolute;
    inset: 0;
    background-color: rgba(22, 22, 20, 0.50);
    z-index: 1;
  }
  .page-headline {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: clamp(3rem, 6.5vw, 5rem);
    letter-spacing: -0.025em;
    color: var(--color-bg);
    margin-bottom: 1.25rem;
  }
  .page-headline em { font-style: italic; color: var(--color-accent); }
  .page-sub {
    font-family: var(--font-body);
    font-size: 1rem;
    font-weight: 300;
    line-height: 1.7;
    color: rgba(242,237,227,0.72);
    max-width: 44ch;
  }

  /* Annual & buyout terms */
  .terms-section {
    background-color: var(--color-bg);
    padding: 3.5rem 0;
  }
  .terms-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }
  @media (min-width: 768px) {
    .terms-grid { grid-template-columns: repeat(2, 1fr); gap: 2rem; }
  }
  .terms-card {
    background-color: var(--color-surface);
    padding: 2rem 2.25rem;
    border-left: 2px solid var(--color-accent);
  }
  .terms-title {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 1.375rem;
    letter-spacing: -0.01em;
    color: var(--color-text);
    margin: 0.5rem 0 0.75rem;
  }
  .terms-body {
    font-family: var(--font-body);
    font-size: 0.9375rem;
    font-weight: 300;
    line-height: 1.7;
    color: var(--color-muted);
    margin: 0;
  }
  .terms-body strong { font-weight: 500; color: var(--color-text); }

  /* Local visibility pricing */
  .auto-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5px;
    background-color: var(--color-stone, #8A8278);
    margin-top: 3rem;
  }
  @media (min-width: 640px) {
    .auto-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (min-width: 1024px) {
    .auto-grid { grid-template-columns: repeat(3, 1fr); }
  }
  .auto-grid--two {
    max-width: 46rem;
    margin: 0 auto;
  }
  @media (min-width: 1024px) {
    .auto-grid--two { grid-template-columns: repeat(2, 1fr); }
  }

  .auto-card {
    background-color: var(--color-bg);
    padding: 2.5rem 2rem;
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
    position: relative;
    transition: transform 0.2s ease;
  }
  .auto-card:hover { transform: translateY(-2px); }
  .auto-card--dark {
    /* Dark ground: text tokens swap to their light variants (see global.css). */
    --color-accent: var(--color-accent-light);
    --color-muted: var(--color-muted-light);
    --color-gold: var(--color-gold-light);
    background-color: var(--color-text);
    color: var(--color-bg);
  }

  .featured-tag {
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    background-color: var(--color-accent-solid);
    color: white;
    font-family: var(--font-body);
    font-size: 0.6rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    padding: 0.3rem 0.875rem;
  }

  .card-top { display: flex; flex-direction: column; gap: 0.5rem; padding-top: 0.5rem; }
  .tier-name {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 1.5rem;
    letter-spacing: -0.015em;
    color: inherit;
  }
  .tier-price {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: 2.875rem;
    letter-spacing: -0.035em;
    line-height: 1;
    color: inherit;
  }
  .tier-desc {
    font-family: var(--font-body);
    font-size: 0.875rem;
    font-weight: 300;
    line-height: 1.6;
    opacity: 0.62;
  }

  .tier-features {
    list-style: none;
    padding: 1.375rem 0 0;
    margin: 0;
    border-top: 1px solid rgba(138,130,120,0.22);
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
    flex: 1;
  }
  .tier-feature {
    display: flex;
    align-items: flex-start;
    gap: 0.625rem;
    font-family: var(--font-body);
    font-size: 0.875rem;
    font-weight: 300;
    line-height: 1.5;
  }
  .tier-feature svg {
    color: var(--color-accent);
    flex-shrink: 0;
    margin-top: 0.175rem;
  }
  .auto-card--dark .tier-feature svg { color: rgba(242,237,227,0.6); }

  .tier-cta {
    width: 100%;
    justify-content: center;
    display: flex;
  }
  .auto-card--dark .btn-secondary {
    border-color: rgba(242,237,227,0.35);
    color: var(--color-bg);
  }
  .auto-card--dark .btn-secondary:hover {
    background-color: rgba(242,237,227,0.1);
  }

  .addons-section {
    background-color: var(--color-surface);
    padding: 5rem 0;
    border-top: 1px solid var(--color-surface);
  }
  .addons-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0;
    border-top: 1px solid var(--color-surface);
    max-width: 540px;
  }
  .addon-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1.125rem 0;
    border-bottom: 1px solid var(--color-surface);
  }
  .addon-item {
    font-family: var(--font-body);
    font-size: 0.9375rem;
    font-weight: 300;
    color: var(--color-text);
  }
  .addon-price {
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 400;
    color: var(--color-accent);
    font-style: italic;
  }

  .faq-section {
    background-color: var(--color-bg);
    padding: 5.5rem 0;
  }
  .faq-list {
    max-width: 680px;
    border-top: 1px solid var(--color-surface);
  }
  .faq-item {
    padding: 2rem 0;
    border-bottom: 1px solid var(--color-surface);
  }
  .faq-q {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 1.25rem;
    color: var(--color-text);
    letter-spacing: -0.01em;
    margin-bottom: 0.75rem;
  }
  .faq-a {
    font-family: var(--font-body);
    font-size: 0.9375rem;
    font-weight: 300;
    line-height: 1.72;
    color: var(--color-muted);
    max-width: 58ch;
    margin: 0;
  }

  /* ── Section divider labels ───────── */
  .pricing-section-label {
    background-color: var(--color-bg);
    padding: 2.5rem 0 0;
    display: flex;
    align-items: center;
    gap: 1.25rem;
    max-width: 72rem;
    margin: 0 auto;
    padding-left: clamp(1.25rem, 4vw, 3rem);
    padding-right: clamp(1.25rem, 4vw, 3rem);
  }
  .pricing-section-label::before,
  .pricing-section-label::after {
    content: '';
    flex: 1;
    height: 1px;
    background-color: var(--color-accent-solid);
    opacity: 0.35;
  }
  .pricing-section-label::before { display: none; }
  .pricing-section-label span {
    font-family: var(--font-body);
    font-size: 0.65rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-accent);
    white-space: nowrap;
    padding-right: 1rem;
  }

  /* ── SEO + GAIO Pricing ──────────── */
  .seo-pricing-section {
    background-color: var(--color-bg);
    padding: 3rem 0 5rem;
    border-top: 1px solid var(--color-surface);
  }
  .seo-headline {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: clamp(2rem, 5vw, 3.25rem);
    letter-spacing: -0.025em;
    color: var(--color-text);
    margin-bottom: 1rem;
    margin-top: 0.5rem;
  }
  .seo-headline em { font-style: italic; color: var(--color-accent); }
  .seo-sub {
    font-family: var(--font-body);
    font-size: 1rem;
    font-weight: 300;
    line-height: 1.7;
    color: var(--color-muted);
    max-width: 48ch;
    margin-bottom: 3.5rem;
  }
  .seo-price {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.375rem;
  }
  .seo-monthly {
    font-family: var(--font-body);
    font-size: 0.875rem;
    font-weight: 400;
    color: var(--color-accent);
    letter-spacing: 0.01em;
  }
  .auto-card--dark .seo-monthly {
    color: rgba(242,237,227,0.6);
  }
</style>
