---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/layout/Header.astro';
import Footer from '../../components/layout/Footer.astro';
import { SITE_URL, SITE_NAME, AUTHOR, BOOKING_URL, PILLARS, pillarOf } from '../../lib/site';

export async function getStaticPaths() {
  const posts = await getCollection('blog', (p) => !p.data.draft);
  return posts.map(entry => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();

const { title, seoTitle, excerpt, date, updatedDate, category, readTime, sources, faq, cta } = entry.data;
const description = entry.data.description ?? excerpt.slice(0, 155);
const pillar = pillarOf(entry.data);
const fmt = (d: string) => new Date(d).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
const formattedDate = fmt(date);
const showUpdated = updatedDate && updatedDate !== date;
const url = `${SITE_URL}/blog/${entry.slug}/`;

// Related posts: same pillar first, then same category, max 2
const allPosts = (await getCollection('blog', (p) => !p.data.draft)).filter(p => p.slug !== entry.slug);
const related = allPosts
  .map(p => ({ p, score: (pillarOf(p.data) === pillar ? 2 : 0) + (p.data.category === category ? 1 : 0) }))
  .filter(x => x.score > 0)
  .sort((a, b) => b.score - a.score || new Date(b.p.data.date).getTime() - new Date(a.p.data.date).getTime())
  .slice(0, 2)
  .map(x => x.p);

const person = {
  "@type": "Person",
  "@id": `${SITE_URL}/#mitchell`,
  "name": AUTHOR.name,
  "jobTitle": AUTHOR.jobTitle,
  "url": AUTHOR.url,
  "worksFor": { "@id": `${SITE_URL}/#business` },
};

const graph: Record<string, unknown>[] = [
  {
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    "@id": `${url}#post`,
    "headline": title,
    "description": description,
    "datePublished": date,
    "dateModified": updatedDate ?? date,
    "mainEntityOfPage": url,
    "url": url,
    "image": `${SITE_URL}/og/${entry.slug}.png`,
    "articleSection": PILLARS[pillar].title,
    "author": person,
    "publisher": { "@id": `${SITE_URL}/#business` },
    ...(sources.length ? { "citation": sources.map(s => ({ "@type": "CreativeWork", "name": s.title, "url": s.url })) } : {}),
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": `${SITE_URL}/` },
      { "@type": "ListItem", "position": 2, "name": "Blog", "item": `${SITE_URL}/blog/` },
      { "@type": "ListItem", "position": 3, "name": PILLARS[pillar].title, "item": `${SITE_URL}/blog/topic/${pillar}/` },
      { "@type": "ListItem", "position": 4, "name": title, "item": url },
    ],
  },
];
if (faq.length) {
  graph.push({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": faq.map(f => ({
      "@type": "Question",
      "name": f.q,
      "acceptedAnswer": { "@type": "Answer", "text": f.a },
    })),
  });
}
---

<BaseLayout
  title={seoTitle ?? title}
  description={description}
  ogType="article"
  ogImage={`${SITE_URL}/og/${entry.slug}.png`}
  publishedTime={date}
  modifiedTime={updatedDate ?? date}
>
  {graph.map(g => <script type="application/ld+json" set:html={JSON.stringify(g)} slot="head"></script>)}

  <Header />
  <main id="main-content">

    <!-- ── Post Header ───────────────────────────────────────── -->
    <section class="post-hero">
      <div class="section-container post-hero-inner">
        <a href={`/blog/topic/${pillar}/`} class="post-back">← {PILLARS[pillar].title}</a>
        <div class="post-hero-content">
          <span class="post-tag">{category}</span>
          <h1 class="post-title">{title}</h1>
          <p class="post-excerpt">{excerpt}</p>
          <div class="post-meta">
            <a href="/about/" class="post-author" rel="author">{AUTHOR.name}, {AUTHOR.jobTitle}</a>
            <span class="post-meta-dot" aria-hidden="true">·</span>
            <time datetime={date}>{formattedDate}</time>
            {showUpdated && (<>
              <span class="post-meta-dot" aria-hidden="true">·</span>
              <span>Updated <time datetime={updatedDate}>{fmt(updatedDate!)}</time></span>
            </>)}
            <span class="post-meta-dot" aria-hidden="true">·</span>
            <span>{readTime}</span>
          </div>
        </div>
      </div>
    </section>

    <!-- ── Post Body ─────────────────────────────────────────── -->
    <section class="post-body-section">
      <div class="section-container">
        <article class="post-body">
          <Content />

          {faq.length > 0 && (
            <section class="post-faq" aria-labelledby="faq-heading">
              <h2 id="faq-heading">Frequently asked questions</h2>
              {faq.map(f => (
                <div class="post-faq-item">
                  <h3>{f.q}</h3>
                  <p>{f.a}</p>
                </div>
              ))}
            </section>
          )}

          <!-- ── Inline CTA ─────────────────────────────────── -->
          <div class="post-cta">
            <p class="post-cta-text">{cta ? 'Want a hand with this?' : 'Ready to get your Montana business showing up in AI search?'}</p>
            <a
              href={`${BOOKING_URL}?utm_source=blog&utm_medium=cta&utm_campaign=${entry.slug}`}
              target="_blank"
              rel="noopener noreferrer"
              class="post-cta-btn"
              data-cta="blog-book-call"
              data-post={entry.slug}
            >
              {cta ?? 'Book a Free Call'}
            </a>
          </div>

          {sources.length > 0 && (
            <aside class="post-sources" aria-labelledby="sources-heading">
              <h2 id="sources-heading">Sources</h2>
              <ol>
                {sources.map(src => (
                  <li><a href={src.url} rel="noopener noreferrer" target="_blank">{src.title}</a></li>
                ))}
              </ol>
            </aside>
          )}
        </article>
      </div>
    </section>

    <!-- ── Related Posts ─────────────────────────────────────── -->
    {related.length > 0 && (
      <section class="related-section">
        <div class="section-container">
          <p class="related-label">More from the blog</p>
          <ul class="related-grid" role="list">
            {related.map(post => (
              <li class="blog-card reveal">
                <a href={`/blog/${post.slug}/`} class="blog-card-link" tabindex="-1" aria-hidden="true"></a>
                <div class="blog-card-top">
                  <span class="blog-tag">{post.data.category}</span>
                  <span class="blog-read-time">{post.data.readTime}</span>
                </div>
                <h2 class="blog-card-title">
                  <a href={`/blog/${post.slug}/`}>{post.data.title}</a>
                </h2>
                <p class="blog-card-excerpt">{post.data.excerpt}</p>
                <div class="blog-card-footer">
                  <a href={`/blog/${post.slug}/`} class="blog-read-more">
                    Read More <span class="read-arrow" aria-hidden="true">→</span>
                  </a>
                  <time class="blog-date" datetime={post.data.date}>
                    {new Date(post.data.date).toLocaleDateString('en-US', {
                      year: 'numeric', month: 'long', day: 'numeric'
                    })}
                  </time>
                </div>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )}

  </main>
  <Footer />
</BaseLayout>

<style>
  /* ── Post Hero ────────────────────────────────────────────── */
  .post-hero {
    /* Dark ground: text tokens swap to their light variants (see global.css). */
    --color-accent: var(--color-accent-light);
    --color-muted: var(--color-muted-light);
    --color-gold: var(--color-gold-light);
    background-color: var(--color-text);
    padding: 3rem 0 4.5rem;
  }
  @media (min-width: 768px) {
    .post-hero { padding: 4rem 0 6rem; }
  }

  .post-hero-inner {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }

  .post-back {
    font-family: var(--font-body);
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--color-gold);
    text-decoration: none;
    letter-spacing: 0.01em;
    align-self: flex-start;
    transition: opacity 0.15s ease;
  }
  .post-back:hover { opacity: 0.72; }

  .post-hero-content { max-width: 760px; }

  .post-tag {
    display: inline-block;
    font-family: var(--font-body);
    font-size: 0.65rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-bg);
    background-color: var(--color-accent-solid);
    padding: 0.3rem 0.75rem;
    margin-bottom: 1.375rem;
  }

  .post-title {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: clamp(2rem, 5vw, 3.375rem);
    line-height: 1.08;
    letter-spacing: -0.03em;
    color: var(--color-bg);
    margin-bottom: 1.25rem;
  }

  .post-excerpt {
    font-family: var(--font-body);
    font-size: 1.0625rem;
    font-weight: 300;
    line-height: 1.68;
    color: rgba(242, 237, 227, 0.55);
    max-width: 58ch;
    margin-bottom: 1.75rem;
  }

  .post-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.625rem;
    font-family: var(--font-body);
    font-size: 0.8125rem;
    font-weight: 300;
    color: rgba(242, 237, 227, 0.62);
  }
  .post-meta-dot { color: rgba(242, 237, 227, 0.55); }

  /* ── Post Body ────────────────────────────────────────────── */
  .post-body-section {
    background-color: var(--color-bg);
    padding: 5rem 0 6rem;
  }

  .post-body {
    max-width: 720px;
    margin: 0 auto;
  }

  /* Prose typography */
  .post-body :global(h2) {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: clamp(1.5rem, 3vw, 2rem);
    line-height: 1.4;
    letter-spacing: -0.025em;
    color: #5A5A58;
    margin-top: 3rem;
    margin-bottom: 1rem;
  }
  .post-body :global(h3) {
    font-family: var(--font-body);
    font-size: 1.125rem;
    font-weight: 600;
    color: #7A7A78;
    margin-top: 2.25rem;
    margin-bottom: 0.75rem;
    letter-spacing: -0.01em;
  }
  .post-body :global(p) {
    font-family: var(--font-body);
    font-size: 1.125rem;
    font-weight: 300;
    line-height: 1.78;
    color: var(--color-text);
    margin-bottom: 1.625rem;
  }
  .post-body :global(ul),
  .post-body :global(ol) {
    font-family: var(--font-body);
    font-size: 1.125rem;
    font-weight: 300;
    line-height: 1.78;
    color: var(--color-text);
    padding-left: 1.5rem;
    margin-bottom: 1.625rem;
  }
  .post-body :global(li) { margin-bottom: 0.5rem; }
  .post-body :global(strong) {
    font-weight: 600;
    color: var(--color-text);
  }
  .post-body :global(a) {
    color: var(--color-gold);
    text-decoration: underline;
    text-underline-offset: 3px;
    transition: opacity 0.15s ease;
  }
  .post-body :global(a:hover) { opacity: 0.75; }
  .post-body :global(blockquote) {
    border-left: 3px solid var(--color-accent);
    padding: 0.75rem 0 0.75rem 1.5rem;
    margin: 2rem 0;
    font-style: italic;
    color: var(--color-muted);
  }
  .post-body :global(hr) {
    border: none;
    border-top: 1px solid var(--color-surface);
    margin: 2.5rem 0;
  }

  /* ── Inline CTA ───────────────────────────────────────────── */
  .post-cta {
    background-color: var(--color-accent-solid);
    padding: 2.5rem;
    margin-top: 3.5rem;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.375rem;
  }
  @media (min-width: 640px) {
    .post-cta {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
  }

  /* Scoped under .post-cta so the post body's paragraph color can't override it on the green fill. */
  .post-cta .post-cta-text {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: clamp(1.125rem, 2.5vw, 1.375rem);
    line-height: 1.3;
    letter-spacing: -0.015em;
    color: var(--color-bg);
    margin: 0;
  }

  .post-cta-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    padding: 0.875rem 1.875rem;
    font-family: var(--font-body);
    font-size: 0.875rem;
    font-weight: 500;
    letter-spacing: 0.025em;
    background-color: var(--color-bg);
    color: var(--color-text);
    text-decoration: none;
    transition: opacity 0.2s ease, transform 0.2s ease;
  }
  .post-cta-btn:hover {
    opacity: 0.9;
    transform: translateY(-1px);
  }

  .post-author { color: inherit; text-decoration: underline; text-underline-offset: 3px; }
  .post-faq { margin-top: 3.5rem; }
  .post-faq-item h3 { margin-top: 1.75rem; }
  .post-faq-item p { margin-bottom: 0.5rem; }
  .post-sources { margin-top: 3rem; padding-top: 1.5rem; border-top: 1px solid var(--color-surface); }
  .post-sources :global(h2) { font-size: 1.125rem; margin-top: 0; }
  .post-sources :global(ol), .post-sources :global(li), .post-sources :global(a) { font-size: 0.9375rem; }

  /* ── Related Posts ────────────────────────────────────────── */
  .related-section {
    background-color: var(--color-surface);
    padding: 4.5rem 0 5.5rem;
  }

  .related-label {
    font-family: var(--font-body);
    font-size: 0.68rem;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin-bottom: 2rem;
  }

  .related-grid {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }
  @media (min-width: 640px) {
    .related-grid { grid-template-columns: 1fr 1fr; }
  }

  /* Shared card styles (also used in related section) */
  .blog-card {
    position: relative;
    background-color: #fff;
    border: 1px solid var(--color-surface);
    padding: 2rem;
    display: flex;
    flex-direction: column;
    gap: 0;
    transition: box-shadow 0.25s ease, transform 0.25s ease;
  }
  .blog-card:hover {
    box-shadow: 0 12px 36px rgba(22, 22, 20, 0.1);
    transform: translateY(-3px);
  }
  .blog-card-link {
    position: absolute;
    inset: 0;
    z-index: 0;
  }
  .blog-card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1.125rem;
  }
  .blog-tag {
    display: inline-block;
    font-family: var(--font-body);
    font-size: 0.65rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-bg);
    background-color: var(--color-accent-solid);
    padding: 0.3rem 0.75rem;
  }
  .blog-read-time {
    font-family: var(--font-body);
    font-size: 0.75rem;
    color: var(--color-muted);
    font-weight: 300;
  }
  .blog-card-title {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: clamp(1.125rem, 2vw, 1.375rem);
    line-height: 1.18;
    letter-spacing: -0.02em;
    color: var(--color-text);
    margin-bottom: 0.875rem;
  }
  .blog-card-title a {
    text-decoration: none;
    color: inherit;
    position: relative;
    z-index: 1;
  }
  .blog-card-title a:hover { color: var(--color-gold); }
  .blog-card-excerpt {
    font-family: var(--font-body);
    font-size: 0.9375rem;
    font-weight: 300;
    line-height: 1.68;
    color: var(--color-muted);
    margin-bottom: 1.75rem;
    flex: 1;
  }
  .blog-card-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--color-surface);
  }
  .blog-read-more {
    font-family: var(--font-body);
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.02em;
    color: var(--color-gold);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    position: relative;
    z-index: 1;
    transition: gap 0.18s ease;
  }
  .blog-read-more:hover { gap: 0.6rem; }
  .read-arrow { transition: transform 0.18s ease; }
  .blog-read-more:hover .read-arrow { transform: translateX(3px); }
  .blog-date {
    font-family: var(--font-body);
    font-size: 0.75rem;
    color: var(--color-muted);
    font-weight: 300;
    white-space: nowrap;
  }
</style>
